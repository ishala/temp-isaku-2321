# ============================================================
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# Database XAMPP MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sentiment_isaku

# JWT Secret — ganti dengan string acak panjang di production
SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang-dan-aman
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_ENV=development
LOG_LEVEL=DEBUG
